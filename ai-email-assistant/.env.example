# --- GitHub Models (LLM) ---
GITHUB_TOKEN=
GITHUB_CHAT_MODEL=gpt-4o-mini
GITHUB_EMBEDDING_MODEL=text-embedding-3-small

# --- Gemini API (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Postgres ---
# Set to false to skip Postgres entirely and use in-memory storage instead
# (no DATABASE_URL needed then, but data is lost on every restart).
USE_POSTGRES=false
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/email_assistant

# --- Redis ---
# Set to false to use an in-memory cache instead - no Redis needed, but
# nothing is cached across restarts or shared between processes. Used to
# cache embeddings (re-ingesting unchanged document chunks skips the API).
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# --- Gmail API (used by the backend to send the approved reply) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=luca.careddu.98@gmail.com

# --- Shared secret n8n sends in the X-Webhook-Token header ---
WEBHOOK_NAME=X-Webhook-Token
WEBHOOK_TOKEN=

# --- RAG ---
DOCUMENTS_PATH=./documents
CHROMA_PATH=./chroma_db

# --- TELEGRAM ---
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=

# --- N8N ---
N8N_BLOCK_ENV_ACCESS_IN_NODE=false