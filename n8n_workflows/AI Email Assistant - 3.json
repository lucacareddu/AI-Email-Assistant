    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": {{ JSON.stringify($env.TELEGRAM_CHAT_ID) }},\n  \"text\": {{ JSON.stringify(\n      \"Nuova email\\n\\n\" +\n      \"Da: \" + $('Gmail Trigger').item.json.from + \"\\n\" +\n      \"Oggetto: \" + $('Gmail Trigger').item.json.subject + \"\\n\\n\" +\n      \"Categoria: \" + $json.category + \"\\n\" +\n      \"Riassunto: \" + $json.summary + \"\\n\\n\" +\n      \"Bozza di risposta:\\n\" + $json.draft + \"\\n\\n[ID: \" + $json.id + \"]\\n\" +\n      \"(Rispondi a questo messaggio con le tue indicazioni per rigenerare la bozza.)\"\n  ) }},\n  \"reply_markup\": {\n    \"inline_keyboard\": [[\n      {\"text\": \"✅ Approve\", \"callback_data\": \"{{ $json.id }}:approve\"},\n      {\"text\": \"❌ Reject\", \"callback_data\": \"{{ $json.id }}:reject\"},\n      {\"text\": \"🔄 Regenerate\", \"callback_data\": \"{{ $json.id }}:regenerate\"}\n    ]]\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        480,
        0
      ],
      "id": "51d7b6ab-8c30-4b7d-88ea-0b7cf947d5e4",
