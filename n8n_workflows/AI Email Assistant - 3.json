      "parameters": {
        "jsCode": "// -1 on first run = fetch only the latest update, so activating the\n// workflow skips any backlog of old taps instead of replaying them.\nconst sd = $getWorkflowStaticData('global');\nreturn [{ json: { offset: sd.tgOffset || -1 } }];"
