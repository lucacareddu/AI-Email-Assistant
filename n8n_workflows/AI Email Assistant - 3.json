      "id": "c313fe0c-b388-4538-874f-bd728b16095c",
      "name": "Is Tip Reply1"
    },
    {
      "parameters": {
        "jsCode": "// id is embedded in the draft message as \"[ID: <id>]\"\nconst item = $('Filter New Updates1').item.json;\nconst originalText = item.message.reply_to_message.text || '';\nconst match = originalText.match(/\\[ID: (\\d+)\\]/);\nconst emailId = match ? match[1] : null;\n\nconst tip = (item.message.text || '').trim();\n\nreturn [{ json: { id: emailId, notes: tip } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
