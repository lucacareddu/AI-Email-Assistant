        336
      ],
      "id": "c3c34c97-2cab-4aef-8822-9967f6669c2b",
      "name": "Schedule Trigger1"
    },
    {
      "parameters": {
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/getUpdates?offset=-1&limit=1&allowed_updates=%5B%22message%22%2C%20%22callback_query%22%5D",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        224,
        336
      ],
      "id": "578cd3de-31de-439a-ac50-bf01d3ced7fe",
      "name": "Get Telegram Updates1"
    },
    {
      "parameters": {
        "jsCode": "// Keeps track of the last processed update_id across executions,\n// the same way the original workflow did, but here we keep every\n// new update (not just the last one) so quick double-taps on the\n// Telegram buttons aren't dropped between polls.\nconst staticData = $getWorkflowStaticData('global');\nconst items = $input.all();\n\nif (items.length === 0 || !items[0].json.result) {\n  return [];\n}\n\nconst updates = items[0].json.result;\nconst lastId = staticData.lastUpdateId || 0;\n\nconst newUpdates = updates.filter((u) => u.update_id > lastId);\nif (newUpdates.length === 0) {\n  return [];\n}\n\nstaticData.lastUpdateId = Math.max(...updates.map((u) => u.update_id));\n\n// One item per update, so the next node can filter button presses\n// (callback_query) and ignore plain text messages.\nreturn newUpdates.map((u) => ({ json: u }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        336
      ],
      "id": "6277f0ea-94aa-4934-befb-974564a226f8",
      "name": "Filter New Updates1"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "0848f644-3a03-456b-8b02-45bee3e649fd",
              "leftValue": "={{ $json.callback_query?.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "name": "filter.operator.notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        672,
