        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/answerCallbackQuery?callback_query_id={{ $json.callback_query.id }}&text=Ricevuto",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
