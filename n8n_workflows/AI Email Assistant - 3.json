    {
      "parameters": {
        "jsCode": "// Telegram resends every update until it is confirmed by the next\n// getUpdates offset; we advance the stored offset past the highest id\n// we just saw so nothing is ever processed twice.\nconst staticData = $getWorkflowStaticData('global');\nconst result = $input.first()?.json?.result;\nif (!result || result.length === 0) {\n  return [];\n}\n\nstaticData.tgOffset = Math.max(...result.map((u) => u.update_id)) + 1;\n\nreturn result.map((u) => ({ json: u }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        336
      ],
      "id": "6277f0ea-94aa-4934-befb-974564a226f8",
      "name": "Filter New Updates1"
    },
