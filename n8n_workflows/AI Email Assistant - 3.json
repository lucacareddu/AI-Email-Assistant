        "jsonBody": "={\n  \"chat_id\": {{ $json.result.chat.id }},\n  \"text\": {{ JSON.stringify(\"💬 Rispondi a questo messaggio con le tue indicazioni per rigenerare la bozza. \" + $json.result.text.match(/\\[ID: \\d+\\]/)[0]) }},\n  \"reply_markup\": {\n    \"force_reply\": true,\n    \"input_field_placeholder\": \"Indicazioni per rigenerare…\"\n  }\n}",
        "options": {}
