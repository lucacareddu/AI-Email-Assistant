        "jsonBody": "={\n  \"id\": {{ $('Filter New Updates1').item.json.callback_query.data.split(':')[0] }},\n  \"action\": {{ JSON.stringify($('Filter New Updates1').item.json.callback_query.data.split(':')[1]) }}\n}",
        "options": {}
