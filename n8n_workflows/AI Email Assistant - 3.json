        "specifyBody": "json",
        "jsonBody": "={\n  \"sender\": {{ JSON.stringify($json.from.value[0].address) }},\n  \"subject\": {{ JSON.stringify($json.subject) }},\n  \"body\": {{ JSON.stringify($json.text || $json.snippet) }}\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
